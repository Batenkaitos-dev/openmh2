# The disc archive maker's built-in tables (arcmake.c): the files of the port's archive with their sectors (config/disc_layout.txt) and
# their sizes and SHA-1 (config/disc.sha1), written as arc_tables.inc in the build directory. A player's folder has no config/, so
# they are built into mh2. The layout file is the list of the archive's files; a file the check-value table does not have, or has
# at another size, stops the configuration.
#
#   mh2_arc_tables(OUTPUT_FILE ROOT)
function(mh2_arc_tables out root)
  set(layout "${root}/config/disc_layout.txt")
  set(sums "${root}/config/disc.sha1")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${layout}" "${sums}")
  file(STRINGS "${sums}" sumlines ENCODING UTF-8)
  file(STRINGS "${layout}" laylines ENCODING UTF-8)
  set(text "/* generated by pc/host/cmake/arc_tables.cmake from config/disc_layout.txt and config/disc.sha1 */\n")
  set(count 0)
  foreach(line IN LISTS laylines)
    if(line MATCHES "^#" OR line STREQUAL "")
      continue()
    endif()
    if(NOT line MATCHES "^([0-9]+) +([0-9]+) +(.+)$")
      message(FATAL_ERROR "${layout}: cannot read the line: ${line}")
    endif()
    set(lba "${CMAKE_MATCH_1}")
    set(size "${CMAKE_MATCH_2}")
    set(path "${CMAKE_MATCH_3}")
    set(sha "")
    foreach(sl IN LISTS sumlines)
      if(sl MATCHES "^([0-9a-f]+) +([0-9]+) +(.+)$")
        set(s_sha "${CMAKE_MATCH_1}")
        set(s_size "${CMAKE_MATCH_2}")
        set(s_path "${CMAKE_MATCH_3}")
        if(s_path STREQUAL path)
          if(NOT s_size EQUAL size)
            message(FATAL_ERROR "${path}: size ${size} in disc_layout.txt, ${s_size} in disc.sha1")
          endif()
          set(sha "${s_sha}")
        endif()
      endif()
    endforeach()
    if(NOT sha)
      message(FATAL_ERROR "${path} is not in ${sums}")
    endif()
    string(APPEND text "    {\"${path}\", ${lba}u, ${size}u, \"${sha}\"},\n")
    math(EXPR count "${count} + 1")
  endforeach()
  if(count LESS 1)
    message(FATAL_ERROR "${layout} lists no files")
  endif()
  file(WRITE "${out}.tmp" "${text}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${out}.tmp" "${out}")
  file(REMOVE "${out}.tmp")
endfunction()
