 			// They will generally be invalidated when it's overwritten by a copy or FB write.
 			if (long_term_cache_texture)
@@ -1761,6 +1770,11 @@ uint32_t GSInterface::drawing_kick_update_texture(FBFeedbackMode feedback_mode,
 
 		TextureInfo info = {};
