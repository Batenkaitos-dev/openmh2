diff --git a/gs/gs_interface.hpp b/gs/gs_interface.hpp
index 9f05da8..a858121 100644
--- a/gs/gs_interface.hpp
+++ b/gs/gs_interface.hpp
@@ -248,6 +248,29 @@ public:
 	virtual bool on_label(uint64_t payload) = 0;
 };
 
+// Optional listener for the texture data the guest uploads to VRAM and the textures the renderer builds from it.
+// All calls come on the thread that feeds the interface. Nothing here changes what is drawn, except that
+// replacement_for() may name another image to sample in place of a cached texture.
+class TextureInterface
+{
+public:
+	virtual ~TextureInterface() = default;
+
+	// A HOST -> LOCAL transfer, once all of its data has arrived (copy.host_data is the whole payload).
+	virtual void on_host_upload(const CopyDescriptor &copy) = 0;
+	// VRAM pages that rendering or a LOCAL -> LOCAL copy writes.
+	virtual void on_vram_damage(const PageRect &rect) = 0;
+	// A CLUT load (TEX0 with CLD asking for one), before the renderer queues it.
+	virtual void on_clut_load(const TEX0Bits &tex0, const TEXCLUTBits &texclut) = 0;
+	// A new cached image is made for desc (one level, one sample, no feedback); desc.hash names it.
+	virtual void on_new_texture(const TextureDescriptor &desc) = 0;
+	// The cached image with this hash is gone.
+	virtual void on_texture_dead(Util::Hash hash) = 0;
+	// The image to sample instead of the cached image with this hash, or null. Called whenever a render pass
+	// takes a texture. The image must have the effective rectangle's aspect, any integer multiple of its size.
+	virtual Vulkan::ImageHandle replacement_for(Util::Hash hash) = 0;
+};
+
 class GSInterface final
 {
 public:
@@ -261,6 +284,7 @@ public:
 
 	// Optional interface if application wants to listen for these IRQ related events.
 	void set_signal_interface(SignalInterface *iface);
+	void set_texture_interface(TextureInterface *iface);
 
 	// GIF payload format.
 	void gif_transfer(uint32_t path, const void *data, size_t size);
@@ -629,5 +653,6 @@ private:
 	void invalidate_promoted_backbuffer(uint32_t fbp);
 
 	SignalInterface *signal_interface = nullptr;
+	TextureInterface *texture_interface = nullptr;
 };
 }
