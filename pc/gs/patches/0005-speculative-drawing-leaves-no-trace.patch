--- a/gs/gs_interface.cpp
+++ b/gs/gs_interface.cpp
@@ -350,6 +350,68 @@
 	render_pass.prim = renderer.get_reserved_primitive_attributes();
 }
 
+void GSInterface::begin_speculation()
+{
+	renderer.set_speculation_sync(true);
+	flush();
+	speculation_clut_instance = render_pass.clut_instance;
+	renderer.save_vram_state();
+	tracker.begin_write_log();
+}
+
+void GSInterface::rewind_speculation()
+{
+	flush();
+	tracker.end_write_log();
+	const std::vector<uint32_t> bits = tracker.get_write_log();
+
+	// What was cached from the pages written is not what they will hold.
+	PageRect rect = {};
+	rect.page_height = 1;
+	rect.block_mask = UINT32_MAX;
+	rect.write_mask = UINT32_MAX;
+	for (size_t i = 0, n = bits.size(); i < n; i++)
+	{
+		for (uint32_t bit = 0; bit < 32; bit++)
+		{
+			if (!(bits[i] & (1u << bit)))
+				continue;
+			rect.base_page = uint32_t(i * 32 + bit);
+			rect.page_width = 1;
+			while (bit + rect.page_width < 32 && (bits[i] & (1u << (bit + rect.page_width))))
+				rect.page_width++;
+			tracker.mark_external_write(rect);
+			bit += rect.page_width - 1;
+		}
+	}
+	flush();
+	renderer.restore_vram_pages(bits);
+
+	// The CLUT cache: the instance of the start, copied to a fresh one (the instances only move forward).
+	if (render_pass.clut_instance != speculation_clut_instance)
+	{
+		uint32_t instance = (render_pass.clut_instance + 1) % CLUTInstances;
+		renderer.copy_clut_instance(speculation_clut_instance, instance);
+		flush();
+		renderer.rewind_clut_instance(instance);
+		render_pass.clut_instance = instance;
+		render_pass.latest_clut_instance = instance;
+		render_pass.num_memoized_palettes = 0;
+	}
+	mark_texture_state_dirty();
+
+	// The aside copy is whole again: it equals local memory now, so it stays, and the log starts afresh.
+	speculation_clut_instance = render_pass.clut_instance;
+	tracker.begin_write_log();
+}
+
+void GSInterface::end_speculation()
+{
+	rewind_speculation();
+	tracker.end_write_log();
+	renderer.set_speculation_sync(false);
+}
