+void GSRenderer::save_vram_state()
+{
+	if (!device || !buffers.gpu)
+		return;
+
+	const VkDeviceSize bytes = buffers.gpu->get_create_info().size / 2;
+	if (!vram_backup || vram_backup->get_create_info().size != bytes)
+	{
+		Vulkan::BufferCreateInfo info = {};
+		info.size = bytes;
+		info.domain = Vulkan::BufferDomain::Device;
+		info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+		vram_backup = device->create_buffer(info);
+		device->set_name(*vram_backup, "vram-backup");
+	}
+
+	ensure_command_buffer(direct_cmd, Vulkan::CommandBuffer::Type::Generic);
+	auto &cmd = *direct_cmd;
+	cmd.begin_region("vram-save");
+	cmd.barrier(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_WRITE_BIT,
+	            VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+	Vulkan::QueryPoolHandle start_ts, end_ts;
+	if (enable_timestamps)
+		start_ts = cmd.write_timestamp(VK_PIPELINE_STAGE_2_COPY_BIT);
+	cmd.copy_buffer(*vram_backup, 0, *buffers.gpu, 0, bytes);
+	if (enable_timestamps)
+	{
+		end_ts = cmd.write_timestamp(VK_PIPELINE_STAGE_2_COPY_BIT);
+		device->register_time_interval("GPU", start_ts, end_ts, "vram-save");
+		timestamps.push_back({ TimestampType::Speculation, std::move(start_ts), std::move(end_ts) });
+	}
+	cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	            VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+	cmd.end_region();
+	flush_submit(0);
+}
+
+void GSRenderer::restore_vram_pages(const std::vector<uint32_t> &page_bits)
+{
+	if (!device || !buffers.gpu || !vram_backup)
+		return;
+
+	const VkDeviceSize slices = vram_backup->get_create_info().size / vram_size;
+	ensure_command_buffer(direct_cmd, Vulkan::CommandBuffer::Type::Generic);
+	auto &cmd = *direct_cmd;
+	cmd.begin_region("vram-restore");
+	cmd.barrier(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_WRITE_BIT,
+	            VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+
+	if (test_stall)
+	{
+		if (!stall_a)
+		{
+			Vulkan::BufferCreateInfo info = {};
+			info.size = 128u << 20;
+			info.domain = Vulkan::BufferDomain::Device;
+			info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+			stall_a = device->create_buffer(info);
+			stall_b = device->create_buffer(info);
+		}
+		for (uint32_t i = 0; i < test_stall; i++)
+		{
+			cmd.copy_buffer(*stall_a, 0, *stall_b, 0, 128u << 20);
+			cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+			            VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT);
+		}
+	}
+	Vulkan::QueryPoolHandle start_ts, end_ts;
+	if (enable_timestamps)
+		start_ts = cmd.write_timestamp(VK_PIPELINE_STAGE_2_COPY_BIT);
+	RangeMerger merger;
+	const auto copy_back = [&](VkDeviceSize offset, VkDeviceSize range) {
+		for (VkDeviceSize slice = 0; slice < slices; slice++)
+			cmd.copy_buffer(*buffers.gpu, vram_size * slice + offset, *vram_backup, vram_size * slice + offset, range);
+	};
+	for (size_t i = 0, n = page_bits.size(); i < n; i++)
+	{
+		Util::for_each_bit(page_bits[i], [&](uint32_t bit) {
+			merger.push(VkDeviceSize(i * 32 + bit) * PageSize, PageSize, copy_back);
+		});
+	}
+	merger.flush(copy_back);
+	if (enable_timestamps)
+	{
+		end_ts = cmd.write_timestamp(VK_PIPELINE_STAGE_2_COPY_BIT);
+		device->register_time_interval("GPU", start_ts, end_ts, "vram-restore");
+		timestamps.push_back({ TimestampType::Speculation, std::move(start_ts), std::move(end_ts) });
+	}
+
+	cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	            VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+	cmd.end_region();
+	flush_submit(0);
+}
+
+void GSRenderer::copy_clut_instance(uint32_t src, uint32_t dst)
+{
+	if (!device)
+		return;
+
+	ensure_command_buffer(direct_cmd, Vulkan::CommandBuffer::Type::Generic);
+	auto &cmd = *direct_cmd;
+	cmd.barrier(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_WRITE_BIT,
+	            VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT);
+	cmd.copy_buffer(*buffers.clut, VkDeviceSize(dst % CLUTInstances) * CLUTSize,
+	                *buffers.clut, VkDeviceSize(src % CLUTInstances) * CLUTSize, CLUTSize);
+	cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	            VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+}
