diff --git a/gs/shaders/ubershader.comp b/gs/shaders/ubershader.comp
index 33be934..e1db9f3 100644
--- a/gs/shaders/ubershader.comp
+++ b/gs/shaders/ubershader.comp
@@ -1229,6 +1229,11 @@ vec4 sample_texture(uint tex_word, uint filtering, vec2 uv, float q, bool perspe
 
 	vec4 color = roundEven(255.0 * color_1);
 
+	// A replacement image with the usual alpha (255 opaque) is read in the GS's scale (128 is opaque).
+	const bool standard_alpha = (tex_info.flags & TEX_INFO_STANDARD_ALPHA) != 0;
+	if (standard_alpha)
+		color.a = floor((color.a * 128.0 + 127.0) / 255.0);
+
 	if (fract_LOD != 0.0)
 	{
 		vec2 scale_2 = ldexp(base_scale, ivec2(-LOD_2));
@@ -1250,6 +1255,8 @@ vec4 sample_texture(uint tex_word, uint filtering, vec2 uv, float q, bool perspe
 			color_2 = textureLod(sampler2D(bindless_textures[tex_index], nearest_sampler), uv_2, LOD_2);
 
 		color_2 = roundEven(255.0 * color_2);
+		if (standard_alpha)
+			color_2.a = floor((color_2.a * 128.0 + 127.0) / 255.0);
 		float weight = floor(fract_LOD * 16.0);
 		color = roundEven(((16.0 - weight) * color + color_2 * weight) * (1.0 / 16.0));
 	}
