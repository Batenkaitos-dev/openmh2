+void GSRenderer::read_clut_instance(uint32_t index, void *dst)
+{
+	if (!device)
+	{
+		memset(dst, 0, CLUTSize);
+		return;
+	}
+
+	Vulkan::BufferCreateInfo info = {};
+	info.size = CLUTSize;
+	info.domain = Vulkan::BufferDomain::CachedHost;
+	info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	auto buffer = device->create_buffer(info);
+
+	auto cmd = device->request_command_buffer();
+	cmd->barrier(VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+	cmd->copy_buffer(*buffer, 0, *buffers.clut, VkDeviceSize(index % CLUTInstances) * CLUTSize, CLUTSize);
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_HOST_READ_BIT);
+	Vulkan::Fence fence;
+	device->submit(cmd, &fence);
+	fence->wait();
+	memcpy(dst, device->map_host_buffer(*buffer, Vulkan::MEMORY_ACCESS_READ_BIT), CLUTSize);
+}
+
+void GSRenderer::write_clut_instance(uint32_t index, const void *src)
+{
+	if (!device)
+		return;
+
+	Vulkan::BufferCreateInfo info = {};
+	info.size = CLUTSize;
+	info.domain = Vulkan::BufferDomain::Host;
+	info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+	auto buffer = device->create_buffer(info, src);
+
+	auto cmd = device->request_command_buffer();
+	cmd->copy_buffer(*buffers.clut, VkDeviceSize(index % CLUTInstances) * CLUTSize, *buffer, 0, CLUTSize);
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_READ_BIT);
+	Vulkan::Fence fence;
+	device->submit(cmd, &fence);
+	fence->wait();
+}
