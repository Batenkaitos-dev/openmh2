+void GSInterface::get_clut_snapshot(void *dst)
+{
+	static_assert(CLUT_SNAPSHOT_BYTES == CLUTSize, "CLUT_SNAPSHOT_BYTES");
+	flush_pending_transfer(true);
+	uint64_t value = tracker.mark_submission_timeline(FlushReason::HostAccess);
+	renderer.flush_submit(value);
+	renderer.wait_timeline(value);
+	renderer.read_clut_instance(render_pass.clut_instance, dst);
+}
+
+void GSInterface::set_clut_snapshot(const void *src)
+{
+	flush_pending_transfer(true);
+	uint64_t value = tracker.mark_submission_timeline(FlushReason::HostAccess);
+	renderer.flush_submit(value);
+	renderer.wait_timeline(value);
+
+	// A fresh instance, as a full load would make; the cache is then rewound to it (which also forgets every
+	// cached texture that was made with another CLUT).
+	uint32_t instance = (render_pass.clut_instance + 1) % CLUTInstances;
+	renderer.write_clut_instance(instance, src);
+	renderer.rewind_clut_instance(instance);
+	render_pass.clut_instance = instance;
+	render_pass.latest_clut_instance = instance;
+	render_pass.num_memoized_palettes = 0;
+	mark_texture_state_dirty();
+}
+
+bool GSInterface::transfer_idle() const
+{
+	return !transfer_state.host_to_local_active &&
+	       transfer_state.fifo_readback_128b_offset >= transfer_state.fifo_readback_128b_size;
+}
