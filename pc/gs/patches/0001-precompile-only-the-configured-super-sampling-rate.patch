Precompile only the configured super-sampling rate

GSRenderer::kick_compilation_tasks() primes the ubershader for all seven
sampling rates. With dynamic_super_sampling off, rendering only ever uses
the configured rate (as GSInterface::set_super_sampling_rate clamps it)
or single sampling, so the other rates' pipelines are never used. On the
MH2 port's machine they held about 1 GB of driver memory. Anything not
precompiled still compiles on first use, as before.

Applied by tools/setup.sh and tools/setup.ps1 to the pinned paraLLEl-GS
commit (tools/versions.txt). paraLLEl-GS is LGPL-3.0-or-later; this patch
is published with the port under the same license.

diff --git a/gs/gs_renderer.cpp b/gs/gs_renderer.cpp
index dbe032d..2eb1bd5 100644
--- a/gs/gs_renderer.cpp
+++ b/gs/gs_renderer.cpp
@@ -548,6 +548,17 @@ void GSRenderer::kick_compilation_tasks()
 				{
 					for (auto &rates : sampling_rates)
 					{
+						if (precompile_samples)
+						{
+							uint32_t samples = 1u << (rates.sample_x + rates.sample_y);
+							if (samples != 1 && samples != precompile_samples)
+								continue;
+							// 4 and 16 samples have an ordered grid (x == y) and a sparse one.
+							if ((samples == 4 || samples == 16) &&
+							    (rates.sample_x == rates.sample_y) != precompile_ordered_grid)
+								continue;
+						}
+
 						for (auto &feedback : feedbacks)
 						{
 							if ((flags & VARIANT_FLAG_FEEDBACK_BIT) != 0)
@@ -833,6 +844,15 @@ bool GSRenderer::init(Vulkan::Device *device_, const GSOptions &options)
 	buffers = {};
 	device = device_;
 	vram_size = options.vram_size;
+
+	// A fixed rate only ever renders at that rate or single-sampled
+	// (GSInterface::set_super_sampling_rate clamps it the same way), so only
+	// those pipelines need precompiling. All rates together are about 1 GB of
+	// driver pipelines; anything else still compiles on first use.
+	precompile_samples = options.dynamic_super_sampling ? 0 :
+	                     std::min<uint32_t>(uint32_t(options.super_sampling),
+	                                        uint32_t(get_max_supported_super_sampling()));
+	precompile_ordered_grid = options.ordered_super_sampling;
 	next_clut_instance = 0;
 	base_clut_instance = 0;
 
diff --git a/gs/gs_renderer.hpp b/gs/gs_renderer.hpp
index d9acc50..74c3ee4 100644
--- a/gs/gs_renderer.hpp
+++ b/gs/gs_renderer.hpp
@@ -545,6 +545,10 @@ private:
 	void drain_compilation_tasks_nonblock();
 	void kick_compilation_tasks();
 	std::atomic_bool compilation_tasks_active;
+	// With a fixed super-sampling rate (no dynamic_super_sampling), the samples
+	// per pixel and grid it uses; 0 precompiles every rate.
+	uint32_t precompile_samples = 0;
+	bool precompile_ordered_grid = true;
 	std::vector<std::future<void>> compilation_tasks;
 
 	uint64_t query_timeline(const Vulkan::SemaphoreHolder &sem) const;
