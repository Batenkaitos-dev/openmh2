+// A TEX1 write with KEEP_BANK set takes the banks (bits 48-55) of the TEX1 it replaces and drops the flag: the game writes
+// the sampling alone (a filter change) between binding a texture and drawing it, and the bank belongs to the texture.
+static uint64_t tex1_keep_banks(uint64_t old_bits, uint64_t payload)
+{
+	constexpr uint64_t banks = 0xffull << 48, keep = 1ull << 56;
+	if (payload & keep)
+		payload = (payload & ~(banks | keep)) | (old_bits & banks);
+	return payload;
+}
